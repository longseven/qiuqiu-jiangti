        { "t": 0.031, "type": "formula", "tex": "$a=\\mathrm{e}^{-\\pi}:\\ f(x)=\\mathrm{e}^{x}\\cos 3x-\\mathrm{e}^{-\\pi}\\mathrm{e}^{3x}\\cos x$", "pos": [4.5, 13.0], "size": 19, "color": "WHITE" },
