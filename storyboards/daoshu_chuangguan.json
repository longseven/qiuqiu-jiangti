        { "t": "@sent:6", "type": "answer", "tex": "$x_1+x_2+x_3>\\frac{\\pi}{2}+\\frac{\\pi}{4}=\\frac{3\\pi}{4}$", "pos": [4.5, 7.95], "size": 27, "color": "GREEN", "cheer": "得证!", "cheer_pos": [7.5, 8.7] }
