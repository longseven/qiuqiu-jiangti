        { "t": 0.05, "type": "formula", "tex": "$\\qquad=3\\sqrt{2}\\,\\mathrm{e}^{x}\\cos\\!\\left(3x+\\frac{\\pi}{4}\\right)$", "pos": [4.5, 11.85], "size": 23, "color": "GREEN" },
        { "t": 0.182, "type": "formula", "tex": "$g(x)<0\\ \\Leftrightarrow\\ x\\in\\!\\left(\\frac{\\pi}{12},\\frac{5\\pi}{12}\\right)$", "pos": [4.5, 10.55], "size": 24, "color": "WHITE" },
